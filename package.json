{
  "name": "docforge",
  "version": "3.1.0",
  "private": true,
  "description": "Offline-first developer toolbox — 20 browser tools (run code in Python via Pyodide, JS/TS in a Web Worker, Lua, SQL; edit Monaco files; convert, diff, format, encrypt, OCR-free utilities). Optional backend enables conversion to DOCX/PDF/XLSX, account, collab, rate-limit.",
  "homepage": "https://github.com/badhope/OnlineCode#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/badhope/OnlineCode.git"
  },
  "license": "MIT",
  "author": "DocForge Contributors",
  "keywords": [
    "offline-first",
    "frontend-runner",
    "pyodide",
    "monaco-editor",
    "sql.js",
    "fengari",
    "code-playground",
    "document-converter",
    "markdown-converter",
    "nextjs",
    "typescript",
    "react",
    "next-intl",
    "static-export",
    "gh-pages",
    "yjs",
    "hocuspocus"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,css,yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "tsx scripts/test-unit.ts",
    "test:verify": "tsx scripts/verify.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.ts",
    "mp:dev": "cd miniprogram && npm run dev:weapp",
    "mp:build": "cd miniprogram && npm run build:weapp",
    "build:gh-pages": "bash scripts/build-gh-pages.sh"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
