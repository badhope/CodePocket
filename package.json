    "@vercel/blob": "^2.4.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.11.1",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.8.0",
    "marked": "^18.0.5",
    "monaco-editor": "^0.55.1",
    "nanoid": "^5.1.11",
    "next": "16.2.9",
    "next-auth": "5.0.0-beta.31",
