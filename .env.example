# --- App ---
NEXT_PUBLIC_APP_NAME="DocForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Node Environment ---
NODE_ENV="development"

# --- Offline / Frontend-first ---
# When NEXT_PUBLIC_STATIC_DEMO=1 the app runs in pure-frontend mode (no backend
# dependency). All 20 tools are served from the browser. This is the default
# for `next build` with `DEPLOY_TARGET=gh-pages` (see scripts/build-gh-pages.sh).
# Set to "0" (or leave unset) for normal development with a real backend.
NEXT_PUBLIC_STATIC_DEMO="0"

# --- Collaboration (Yjs / Hocuspocus) ---
# WebSocket URL of the optional collab-server. When unset the editor falls back
# to single-user mode and the collab features are hidden in the UI.
#   local: ws://localhost:1234
#   prod:  wss://onlinecode-collab.fly.dev
NEXT_PUBLIC_COLLAB_URL=""

# --- Database (Vercel Postgres / Neon) ---
POSTGRES_URL="postgres://user:pass@host:5432/db"

# --- Auth (NextAuth v5) ---
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# OAuth providers (optional)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Upstash Redis ---
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# --- Vercel Blob ---
BLOB_READ_WRITE_TOKEN=""

# --- Sentry ---
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
NEXT_PUBLIC_SENTRY_DSN=""

# --- File Upload ---
MAX_FILE_SIZE_MB="50"

# --- Rate Limiting ---
RATE_LIMIT_CONVERT_PER_MIN="30"
RATE_LIMIT_API_PER_MIN="120"

# --- Piston (local shim; emkc.org is whitelist-only since 2026-02-15) ---
# Run `make piston-up` to start the local shim, then leave PISTON_API_URL unset
# or point it at the local URL below. The default upstream URL is kept for
# deployments that have their own Piston / whitelisted key.
# PISTON_API_URL="https://emkc.org/api/v2/piston"
PISTON_API_URL="http://127.0.0.1:2000/api/v2"

# --- Collab Server (infra/collab-server/server.mjs) ---
# Only required if you run your own Yjs WebSocket server. The defaults below
# match infra/collab-server/docker-compose.yml and fly.toml.
COLLAB_PORT="1234"
COLLAB_REQUIRE_AUTH="false"
COLLAB_SHARED_SECRET=""
COLLAB_MAX_DOCS="1000"
COLLAB_DOC_TTL_MS="3600000"
