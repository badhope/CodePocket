FROM ghcr.io/engineer-man/piston:latest

# Enable networking for package managers (pip/npm/cargo/go)
ARG PISTON_PORT=2000
ARG PISTON_LOG_LEVEL=info
ARG PISTON_DISABLE_NETWORK=false
ARG PISTON_ENABLE_NETWORK=true
ARG PISTON_MAX_CONCURRENT=8
ARG PISTON_LIMIT_CPU_TIME=true
ARG PISTON_LIMIT_MEMORY=true
ARG PISTON_LIMIT_WALL_TIME=true
ARG PISTON_RUNNER_DETECTION=shared
ARG PISTON_RUN_TIMEOUT=60000
ARG PISTON_COMPILE_TIMEOUT=60000
ARG PISTON_CACHE_DIR=/piston_cache
ARG PISTON_KEY=local-dev

ENV PISTON_PORT=${PISTON_PORT}
ENV PISTON_LOG_LEVEL=${PISTON_LOG_LEVEL}
ENV PISTON_DISABLE_NETWORK=${PISTON_DISABLE_NETWORK}
ENV PISTON_ENABLE_NETWORK=${PISTON_ENABLE_NETWORK}
ENV PISTON_MAX_CONCURRENT=${PISTON_MAX_CONCURRENT}
ENV PISTON_LIMIT_CPU_TIME=${PISTON_LIMIT_CPU_TIME}
ENV PISTON_LIMIT_MEMORY=${PISTON_LIMIT_MEMORY}
ENV PISTON_LIMIT_WALL_TIME=${PISTON_LIMIT_WALL_TIME}
ENV PISTON_RUN_TIMEOUT=${PISTON_RUN_TIMEOUT}
ENV PISTON_COMPILE_TIMEOUT=${PISTON_COMPILE_TIMEOUT}
ENV PISTON_RUNNER_DETECTION=${PISTON_RUNNER_DETECTION}
ENV PISTON_CACHE_DIR=${PISTON_CACHE_DIR}
ENV PISTON_KEY=${PISTON_KEY}

EXPOSE 2000

HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD wget --quiet --tries=1 --spider http://localhost:2000/api/v2/runtimes || exit 1

CMD ["node", "/piston_api/src/index.js"]
