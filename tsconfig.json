{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "webworker"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/public/*": [
        "./public/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/lib/**/*.ts",
    "src/lib/**/*.tsx",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/messages/**/*.json",
    "src/middleware.ts",
    "src/proxy.ts",
    "src/app/globals.css",
    "src/app/layout.tsx",
    "src/app/page.tsx",
    "src/app/not-found.tsx",
    "src/app/loading.tsx",
    "src/app/error.tsx",
    "src/app/manifest.webmanifest/route.ts",
    "src/app/favicon.ico/route.ts",
    "src/app/robots.ts",
    "src/app/sitemap.ts",
    "src/app/global-error.tsx",
    "src/app/api/convert/route.ts",
    "src/app/api/convert/formats/route.ts",
    "src/app/api/conversions/route.ts",
    "src/app/api/conversions/[id]/route.ts",
    "src/app/api/conversions/[id]/download/route.ts",
    "src/app/api/health/route.ts",
    "src/app/api/me/route.ts",
    "src/app/api/auth/sign-up/route.ts",
    "src/app/api/auth/[...nextauth]/route.ts",
    "src/app/[locale]/layout.tsx",
    "src/app/[locale]/page.tsx",
    "src/app/[locale]/not-found.tsx",
    "src/app/[locale]/loading.tsx",
    "src/app/[locale]/error.tsx",
    "src/app/[locale]/convert/page.tsx",
    "src/app/[locale]/history/page.tsx",
    "src/app/[locale]/dashboard/page.tsx",
    "src/app/[locale]/pricing/page.tsx",
    "src/app/[locale]/settings/page.tsx",
    "src/app/[locale]/docs/page.tsx",
    "src/app/[locale]/sign-in/page.tsx",
    "src/app/[locale]/sign-up/page.tsx",
    "next.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "miniprogram",
    "tests",
    "scripts",
    "src/app/api/execute",
    "src/app/api/executions",
    "src/app/api/projects",
    "src/app/api/snippets",
    "src/app/api/share",
    "src/app/api/s",
    "src/app/api/cron",
    "src/app/api/runtimes",
    "src/app/[locale]/playground",
    "src/app/[locale]/projects",
    "src/app/[locale]/snippets",
    "src/app/[locale]/s",
    "src/app/[locale]/offline"
  ]
}
